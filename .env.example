# Copy to .env.local for development; set the same keys in Vercel for production.

# Supabase — project udqvdkuiwmzhlrqxvvks → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://udqvdkuiwmzhlrqxvvks.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for subscription writes and account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — console.anthropic.com → API Keys (server-side only, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=sk-ant-...

# Razorpay — dashboard.razorpay.com → Settings → API Keys (use test keys until launch)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Subscriptions → Plans: create ₹299/month and ₹1,999/year plans and paste their ids
RAZORPAY_PLAN_MONTHLY=plan_...
RAZORPAY_PLAN_YEARLY=plan_...
# Settings → Webhooks: URL <site>/api/billing/webhook, events subscription.*, this secret
RAZORPAY_WEBHOOK_SECRET=...

# Twilio — WhatsApp channel (console.twilio.com → Account Info; Messaging → WhatsApp senders)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number for testing; your approved sender in production
NEXT_PUBLIC_WHATSAPP_NUMBER=+14155238886     # same number, shown to parents for the wa.me link
# TWILIO_WEBHOOK_URL=https://www.kahiye.app/api/whatsapp/webhook  # only if it differs from NEXT_PUBLIC_SITE_URL + path

# Database connection for `npm run db:migrate` (local only — never add to Vercel)
# Supabase → Connect → Session pooler → URI, with your database password filled in
SUPABASE_DB_URL=postgresql://postgres.udqvdkuiwmzhlrqxvvks:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# ElevenLabs — studio narration for bedtime stories (optional; without it the device voice reads aloud)
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # pick a warm voice in the ElevenLabs voice library
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Resend — email alert to your team when a parent requests an expert call (optional)
# RESEND_API_KEY=re_...
# RESEND_FROM=Kahiye <alerts@kahiye.app>   # must be a verified Resend domain
# EXPERT_NOTIFY_EMAIL=you@example.com

# Optional tuning
# BUDDING_MODEL=claude-opus-5-5       # decodes and weekly reports (the product)
# BUDDING_FAST_MODEL=claude-haiku-4-5 # safety check + caregiver messages; defaults to BUDDING_MODEL
# BUDDING_EFFORT=low                # low | medium | high — low keeps answers fast
# NEXT_PUBLIC_FREE_DECODES_PER_WEEK=3
# NEXT_PUBLIC_PLUS_DECODES_PER_DAY=10   # fair-use cap; protects margin on heavy users

# Public site URL (social preview metadata and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
